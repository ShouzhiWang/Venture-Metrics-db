DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/data_center_agent
DEMO_READ_DATABASE_URL=
STORAGE_ROOT=data
HTTP_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
OPENAI_API_KEY=
OPENAI_BATCH_MODEL=gpt-4.1-mini
OPENAI_BATCH_REVIEW_MODEL=gpt-4.1-mini
OPENAI_BATCH_MAX_INPUT_TOKENS_PER_REPORT=45000
OPENAI_BATCH_PROMPT_VERSION=codebook_extraction_v1
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
LOCAL_EMBEDDING_FALLBACK_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_NORMALIZE=true
EMBEDDING_DEVICE=auto
EMBEDDING_MODEL_CACHE_DIR=
SEARCH_INDEX_BATCH_SIZE=100
SEARCH_INDEX_MAX_TEXT_CHARS=6000
