WEB_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/data_center_agent
DEMO_READ_DATABASE_URL=
STORAGE_ROOT=data
LOG_LEVEL=INFO
WEB_PORT=8080

DEMO_LLM_PROVIDER=openai
DEMO_LLM_BASE_URL=https://api.openai.com/v1
DEMO_LLM_MODEL=gpt-4o-mini
DEMO_LLM_API_KEY=
DEMO_LLM_TIMEOUT_SECONDS=30
DEMO_LLM_MAX_OUTPUT_TOKENS=900

# Optional: if semantic search should use a local model inside the API container,
# mount/provide a model cache and ensure the image has the embeddings extra.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
LOCAL_EMBEDDING_FALLBACK_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_NORMALIZE=true
EMBEDDING_DEVICE=auto
EMBEDDING_MODEL_CACHE_DIR=
